<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ReadyToRunEnvelope</AssemblyName>
    <ApplicationId>com.github.copilot.r2renvelope.cc24e062.simple</ApplicationId>
    <ApplicationTitle>R2R envelope experiment</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <PublishReadyToRunCrossgen2ExtraArgs>--partial</PublishReadyToRunCrossgen2ExtraArgs>
    <AndroidTypeMapImplementation>trimmable</AndroidTypeMapImplementation>
    <AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
    <AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(_AndroidReadyToRunEnvelopeDiagnostic)' == 'true' ">
    <AndroidManifest>Properties/AndroidManifest.diagnostic.xml</AndroidManifest>
    <EnableDiagnostics>true</EnableDiagnostics>
    <DefineConstants>$(DefineConstants);R2R_DIAGNOSTIC</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition=" '$(_AndroidReadyToRunEnvelopeDiagnostic)' == 'true' ">
    <AndroidEnvironment Include="diagnostic.env" />
  </ItemGroup>
</Project>
